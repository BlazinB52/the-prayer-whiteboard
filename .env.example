NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public canonical site URL used for email links. Production must be https://theprayerwhiteboard.com.
NEXT_PUBLIC_SITE_URL=

# Server-only Sender.net transactional email settings. Do not prefix these with NEXT_PUBLIC_.
SENDER_API_KEY=
SENDER_FROM_EMAIL=updates@theprayerwhiteboard.com
SENDER_FROM_NAME=The Prayer Whiteboard

# Sender.net group IDs that confirmed devotional subscribers are added to.
# Every confirmed devotional subscriber joins the master group.
SENDER_DEVOTIONAL_MASTER_GROUP_ID=bo98N3
# Optional per-series groups, as a comma-separated list of "devotional-slug:groupId".
SENDER_DEVOTIONAL_SERIES_GROUP_IDS=aliyah-israel-the-harvest-and-prayer:bmVQgn,beyond-the-garden:e30QBQ,5787-the-year-of-the-spoken-word-and-divine-rest:bWzpxx
